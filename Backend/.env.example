# Salin berkas ini menjadi .env lalu isi nilainya.
# Jangan pernah mengisi kredensial sungguhan di .env — .env tidak ikut ke GitHub.

# Port server HTTP
PORT=3000

# Koneksi PostgreSQL — lokal (pengembangan) atau Neon/Supabase (produksi)
DATABASE_URL=postgresql://postgres:password@localhost:5432/warung_bu_eni

# Asal yang diizinkan mengakses API (frontend saat pengembangan)
CORS_ORIGIN=http://localhost:5173

# Kunci layanan AI — disimpan HANYA di server, tidak pernah di frontend
# AI_API_KEY=
# AI_BASE_URL=
