# Salin berkas ini menjadi .env lalu isi nilainya.
# Jangan pernah mengisi kredensial sungguhan di .env.example — .env tidak ikut ke GitHub.

# Port server HTTP
PORT=3000

# Asal yang diizinkan mengakses API (frontend saat pengembangan)
CORS_ORIGIN=http://localhost:5173

# Koneksi PostgreSQL — dipakai mulai Tahap 2
# Lokal: postgresql://postgres:<password>@localhost:5432/warung_bu_eni
DATABASE_URL=

# Token pemilik untuk endpoint admin (Inti, sebelum login sungguhan).
# Buat nilai acak minimal 16 karakter, mis. `openssl rand -hex 24`.
PEMILIK_TOKEN=

# Batas waktu tunggu layanan AI dalam milidetik (KONTRAK-API.md bagian 6)
AI_TIMEOUT_MS=8000

# Layanan AI — disimpan HANYA di server, tidak pernah di frontend. Dipakai Tahap 3.
AI_BASE_URL=
AI_API_KEY=
